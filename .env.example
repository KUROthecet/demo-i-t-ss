# ===== Redis =====
# Local: redis://localhost:6379
# Upstash (cloud free): rediss://default:password@host.upstash.io:port
REDIS_URL=redis://localhost:6379

# ===== Database =====
# For local Docker: use localhost values below
# For cloud (Neon, Railway, Supabase): paste the full JDBC connection string
DATABASE_URL=jdbc:postgresql://localhost:5435/aims_db?reWriteBatchedInserts=true
DB_USERNAME=aims_user
DB_PASSWORD=aims_password

# Docker Compose overrides (local dev only)
POSTGRES_USER=aims_user
POSTGRES_PASSWORD=aims_password
POSTGRES_DB=aims_db
POSTGRES_PORT=5435

# ===== JWT =====
JWT_SECRET=AIMSShopSecretKeyForJWTTokenGeneration2026MustBe256BitsLong!
JWT_EXPIRATION_MS=86400000

# ===== Frontend URL (for CORS) =====
# Set to your Vercel domain in production
FRONTEND_URL=http://localhost:4200

# ===== Manager email (receives refund/contact notifications) =====
MANAGER_EMAIL=manager@aims.vn

# ===== Default account passwords (only used on first DB seed) =====
ADMIN_PASSWORD=admin123
MANAGER_PASSWORD=manager123

# ===== Email (Mailtrap for dev, real SMTP for prod) =====
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

