# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
FRONTEND_URL=http://localhost:4200        # Vercel domain in production

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev (Docker Compose): keep defaults below
# Production (Neon / Railway): set DATABASE_URL to the full JDBC connection string
DATABASE_URL=jdbc:postgresql://localhost:5435/aims_db?reWriteBatchedInserts=true
DB_USERNAME=aims_user
DB_PASSWORD=aims_password
DB_NAME=aims_db                           # used by Docker Compose to init the DB

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Upstash (cloud free): rediss://default:<token>@<host>.upstash.io:<port>
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate your own: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-256-bit-secret
JWT_EXPIRATION_MS=86400000                # 24 h

# ─── Initial account passwords (applied once on first DB seed) ────────────────
ADMIN_PASSWORD=admin123
MANAGER_PASSWORD=manager123
MANAGER_EMAIL=manager@aims.vn

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Dev:  Mailtrap sandbox   https://mailtrap.io → Inboxes → SMTP credentials
# Prod: real SMTP provider (SendGrid, Postmark, Gmail App Password, etc.)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-mailtrap-inbox-username
MAIL_PASSWORD=your-mailtrap-inbox-password
MAIL_FROM_ADDRESS=aims.noreply@gmail.com

# ─── PayPal Sandbox ───────────────────────────────────────────────────────────
# Create a sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Dashboard: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
